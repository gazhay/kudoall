{
   "manifest_version": 3,
   "name": "Ladder Tools for Strava",
   "version": "1.2.0",
   "description": "Replaces virtual ride maps with real-world basemaps and adds a Kudo All button to your Strava dashboard.",
   "icons": {
      "16": "images/icon-16.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
   },
   "content_scripts": [
      {
         "css": [ "lib/leaflet.css", "virtualmap.css" ],
         "js": [ "lib/leaflet.js", "location.js", "kudoall.js", "virtualmap.js" ],
         "matches": [ "*://*.strava.com/dashboard*" ],
         "run_at": "document_end"
      },
      {
         "css": [ "lib/leaflet.css", "virtualmap.css" ],
         "js": [ "lib/leaflet.js", "location.js", "virtualmap.js" ],
         "matches": [ "*://*.strava.com/activities/*" ],
         "run_at": "document_end"
      }
   ],
   "permissions": [],
   "web_accessible_resources": [ {
      "matches": [ "*://*.strava.com/*" ],
      "resources": [ "images/*", "lib/images/*", "maps/*" ]
   } ]
}
